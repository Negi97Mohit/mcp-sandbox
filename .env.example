# Required
DISCORD_TOKEN=your_discord_bot_token
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional — GitHub SDLC Integration
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_DEFAULT_REPO=owner/repo-name          # Default repo for !agent commands

# Optional — LLM Tracing (Langfuse — EU-hosted, GDPR compliant)
# Get free keys at https://cloud.langfuse.com
LANGFUSE_SECRET_KEY=sk-lf-your_secret_key
LANGFUSE_PUBLIC_KEY=pk-lf-your_public_key
LANGFUSE_HOST=https://cloud.langfuse.com     # Or your self-hosted URL

# Optional — Netlify CI/CD Monitoring
NETLIFY_TOKEN=your_netlify_personal_access_token

# Optional — Super Admin (auto-promoted to admin, bypasses permission store)
ALLOWED_USER_ID=your_discord_user_id

# Optional — Model override (default is free NVIDIA Nemotron)
MODEL_NAME=nvidia/nemotron-3-nano-30b-a3b:free

# Optional — Firebase
SERVICE_KEY_PATH=service-account.json
