    "discord.js": "^14.25.1",
    "dotenv": "^17.2.3",
    "firebase-admin": "^13.6.0",
    "langfuse": "^3.38.20",
    "openai": "^6.16.0",
    "simple-git": "^3.33.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "electron": "^42.3.2",
    "tsx": "^4.21.0"
